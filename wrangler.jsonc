{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "product-ai",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-09",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// 自定义域名：要求 hesen.dpdns.org 已作为 Active zone 托管在当前 Cloudflare 账号
	"routes": [
		{
			"pattern": "ai.hesen.dpdns.org",
			"custom_domain": true,
		},
	],
	// 配置 routes 后 workers.dev 默认关闭；显式保留，便于证书签发期间验证
	"workers_dev": true,
	// 链路追踪 & 日志：Worker 执行的每个请求产生 trace 和 log，可在 Cloudflare 仪表板实时查看
	"observability": {
		"traces": {
			"enabled": true,
			// 100% 采样：流量小（导购系统），全量保留便于排查
			"head_sampling_rate": 1.0,
		},
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1.0,
		},
	},
	// 把 sql/*.sql 作为文本模块打包，让 src/schema.ts 可以直接 import DDL 文件
	"rules": [
		{
			"type": "Text",
			"globs": [
				"**/*.sql"
			],
			"fallthrough": false,
		},
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		],
	},
	"ai": {
		"binding": "AI",
	},
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "product-catalog",
		},
	],
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "04964b18b89d442d8f5d361c022840b5",
		},
	],
	// AI Search：知识库专属检索引擎（SKU 商品检索强制 Vectorize，不再共享引擎选择）。
	// 本地 wrangler dev 需要 `npx wrangler dev --remote`，AI Search 不在本地模拟。
	"ai_search_namespaces": [
		{
			"binding": "AI_SEARCH",
			"namespace": "default",
		},
	],
	"vars": {
		"EMBEDDING_MODEL": "@cf/baai/bge-m3",
		"CHAT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
		"VECTORIZE_INDEX_NAME": "product-catalog",
		"AI_SEARCH_INSTANCE": "product-catalog-search",
	},
}