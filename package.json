{
  "name": "cf-product-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Workers + Vectorize + Hyperdrive + Workers AI 商品知识库与对话推荐系统",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "sql:check": "node scripts/check-sql.mjs",
    "test:intent": "node scripts/test-intent.mjs",
    "test:frontend": "node scripts/test-frontend.mjs",
    "test": "npm run test:intent && npm run test:frontend",
    "predeploy": "npm run sql:check",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "npm run sql:check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "cf-typegen": "wrangler types",
    "ingest": "node scripts/ingest.mjs",
    "ingest:migrate": "node scripts/ingest.mjs --migrate",
    "ingest:knowledge": "node scripts/ingest.mjs --knowledge-only",
    "sync:ai-search": "node scripts/sync-ai-search.mjs",
    "agent": "node scripts/dev-agent.mjs",
    "agent:check": "node scripts/dev-agent.mjs check",
    "agent:guard": "node scripts/dev-agent.mjs guard",
    "agent:baseline": "node scripts/dev-agent.mjs baseline",
    "agent:log": "node scripts/dev-agent.mjs log",
    "agent:digest": "node scripts/dev-agent.mjs digest --days=7",
    "agent:hooks": "node scripts/dev-agent.mjs install-hooks"
  },
  "dependencies": {
    "hono": "^4.13.17",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0"
  }
}
